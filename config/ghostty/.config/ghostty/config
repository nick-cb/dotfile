background=#1E1E1E
foreground=#D4D4D4

# black
palette = 0=#181818
palette = 8=#404040
# red
palette = 1=#d16969
palette = 9=#d16969
# green
palette = 2=#6a9955
palette = 10=#6a9955
# yellow
palette = 3=#d7ba7d
palette = 11=#d7ba7d
# blue
palette = 4=#569cd6
palette = 12=#569cd6
# purple
palette = 5=#d16d9e
palette = 13=#d16d9e
# aqua
palette = 6=#4ec9b0
palette = 14=#4ec9b0
# white
palette = 7=#d4d4d4
palette = 15=#d4d4d4

window-inherit-font-size=false
window-colorspace=display-p3

font-family=JetBrainsMono Nerd Font Mono

font-size=14

# adjust-cell-height=30%

selection-background=#264f78
selection-foreground=#D4D4D4

# macos-shortcuts=ask

macos-titlebar-style=tabs
macos-non-native-fullscreen=visible-menu
macos-icon=xray
# macos-icon-ghost-color=#569cd6
# macos-icon-screen-color=#569cd6
gtk-titlebar=true

cursor-style-blink=false

# custom-shader=./ghostty-shaders/smoke-and-ghost.glsl

keybind = option+shift+enter>l=new_split:right
keybind = option+shift+enter>h=new_split:left
keybind = option+shift+enter>j=new_split:down
keybind = option+shift+w=close_surface
keybind = option+shift+[=goto_split:previous
keybind = option+shift+]=goto_split:next
keybind = command+shift+t=toggle_quick_terminal
# keybind = option+p=toggle_command_palette
shell-integration-features=sudo


